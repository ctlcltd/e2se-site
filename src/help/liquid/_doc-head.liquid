<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% unless templateName == "index" %}{{ toc[templateName].title | append: " - " | append: distName | escape }}{% else %}{{ toc[templateName].title | escape }}{% endunless %}</title>
<meta name="description" content="{{ toc[templateName].description | escape }}">{% if distributable %}
<meta name="robots" content="noindex,noarchive">
<style>{% render "{{ stylesheet }}" %}</style>{% endif %}{% if deploy %}
<link rel="canonical" href="{% canonicalUrl %}">{% endif %}{% unless distributable %}
<link rel="stylesheet" href="{{ '/style.css' | asset: deploy }}">
<link rel="stylesheet" href="{{ '/help.css' | asset: deploy }}">{% endunless %}
</head>